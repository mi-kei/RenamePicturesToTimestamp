{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Photo Renamer",
  "version": "0.1.0",
  "identifier": "com.renamepictures.timestamp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Photo Renamer",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 600,
        "create": false
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  }
}